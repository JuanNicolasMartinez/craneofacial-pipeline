# Variables del despliegue de contenedor único. TODAS son opcionales: sin
# ninguna, la app arranca autocontenida (SQLite + Redis embebido + disco
# local) y sirve el SPA en el mismo puerto. Detalle en
# docs/arquitecture/DEPLOY_FREE.md

# Puerto HTTP. Render/Railway/Koyeb lo inyectan solos; Hugging Face usa 7860.
PORT=8000

# Directorio de datos: SQLite, archivos subidos y el secreto JWT generado.
# En plataformas donde solo /tmp es escribible, usa /tmp/data.
DATA_DIR=/data

# Firma de la sesión. Sin definirla se genera una y se guarda en DATA_DIR
# (si el disco es efímero, cada reinicio cierra las sesiones abiertas).
# Generar con: openssl rand -hex 32
# JWT_SECRET_KEY=

# Cookie de sesión: true en cualquier despliegue con HTTPS.
COOKIE_SECURE=true
COOKIE_SAMESITE=lax

# ── Servicios externos (opcionales) ───────────────────────────────────────────
# Postgres gestionado. Acepta el formato que publica el proveedor
# (postgres://... o ?sslmode=require): el backend lo adapta a asyncpg.
# DATABASE_URL=

# Redis gestionado. Sin esto se usa el redis-server embebido en la imagen.
# REDIS_URL=

# Almacenamiento S3-compatible (en lugar del disco local).
# STORAGE_BACKEND=r2
# R2_ENDPOINT_URL=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=
# R2_ACCOUNT_ID=

# Modelo FLAME: URL directa al generic_model.pkl. Se descarga en el arranque
# si aún no está en FLAME_MODEL_PATH ni horneado en deploy/flame/.
# Sin él, el paso 9 falla y el resto de la app funciona.
# FLAME_MODEL_URL=
# FLAME_MODEL_PATH=/data/flame/generic_model.pkl

# Concurrencia del worker Celery (1 basta en instancias pequeñas).
CELERY_CONCURRENCY=1
